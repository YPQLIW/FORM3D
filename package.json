{
  "name": "form3d",
  "private": true,
  "version": "0.4.5",
  "type": "module",
  "description": "FORM3D — AI 3D Creation Studio",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev -w @form3d/web",
    "setup": "node scripts/setup-backend.mjs",
    "ai:key": "node scripts/set-api-key.mjs",
    "build": "npm run build -w @form3d/web",
    "preview": "npm run preview -w @form3d/web",
    "typecheck": "npm run typecheck -w @form3d/web",
    "test": "vitest run",
    "test:backend": "node scripts/test-backend.mjs",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "test:e2e:phase2": "node scripts/e2e-phase2.mjs",
    "test:e2e:phase3": "node scripts/e2e-phase3.mjs",
    "test:e2e:phase4": "node scripts/e2e-phase4.mjs",
    "test:e2e:phase45": "node scripts/e2e-phase45.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
