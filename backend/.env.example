# FORM3D 로컬 서버 설정 (이 파일을 복사해 .env 로 저장하세요)
# .env 파일은 이 컴퓨터의 backend 폴더에만 있고, 웹 화면(프런트엔드)으로 전달되지 않습니다.

# Claude API 키 (없으면 AI 기능은 '연결 안 됨'으로 표시되고, 기본 명령 해석기만 동작)
ANTHROPIC_API_KEY=

# 사용할 모델 (기본: claude-opus-5-5)
# FORM3D_AI_MODEL=claude-opus-5-5
# 생각 깊이: low | medium | high (기본 low = 빠른 응답)
# FORM3D_AI_EFFORT=low

# 프로젝트 저장 폴더 (기본: 문서\FORM3D)
# FORM3D_DATA_DIR=

# 서버 포트 (기본 8765)
# FORM3D_PORT=8765
